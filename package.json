{
  "name": "pi-herdr-subagents",
  "version": "0.1.0",
  "description": "Async subagents for pi, running in herdr panes — spawn, orchestrate, and steer results back without blocking the main session",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewfung729/pi-herdr-subagents.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:unit": "node --test test/test.ts test/system-prompt-mode.test.ts",
    "test:surface": "node --test --test-concurrency=1 test/integration/herdr-surface.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "check": "biome check --error-on-warnings . && tsgo --noEmit",
    "check:herdr-skill": "node scripts/check-herdr-skill.ts",
    "fix": "biome check --write --error-on-warnings .",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
